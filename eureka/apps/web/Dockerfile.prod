# Production image for the EUREKA web app (XR-9).
#
# Why this exists: the compose stack used to serve the app through `next dev`
# (Dockerfile.dev), which compiles routes on demand. The heavy three.js XR
# routes pull ~3,000 modules per compile; inside the shared Docker VM those
# compile spikes were repeatedly OOM-killed by the kernel (docker events show
# `oom` immediately before each `die`), the restart wiped the compile cache,
# and every click after a restart paid a multi-second cold compile — the
# "taking too long to load" loop.
#
# A production build has no compile-at-request-time at all: every route is
# prebuilt by `next build`, `next start` serves them in ~100ms, and steady-
# state memory is a few hundred MB with no spikes. Dev-mode (HMR) remains
# available via the `web-dev` compose profile.
#
# NEXT_PUBLIC_* values are inlined at build time; the ARGs below default to
# the same localhost endpoints docker-compose wires, so a plain build Just
# Works for the local stack.

FROM node:20-alpine

WORKDIR /app

# .npmrc carries legacy-peer-deps=true (see Dockerfile.dev for why).
COPY package*.json .npmrc ./

# This should be `npm ci`, and cannot be yet. See LOCKFILE below.
#
# From a clean cache `npm install` does resolve the platform-specific SWC
# binary correctly. What it does not do is stay put: a stale cached layer of
# this step was serving a tree with @next/swc-linux-arm64-musl missing, and
# the build died with "Failed to load SWC binary for linux/arm64". That fails
# here and nowhere else, because musl is what Alpine uses and every developer
# machine in this project is glibc or macOS. If it recurs, rebuild this layer
# with `docker compose build --no-cache web`.
#
# LOCKFILE: eureka/ is an npm workspace root (apps/*, services/*) and its real
# lockfile is eureka/package-lock.json. The apps/web/package-lock.json copied
# on the line above is a vestigial standalone file that predates the workspace
# and is missing ten packages that apps/web/package.json depends on
# (@next/bundle-analyzer, the @testing-library set, @vitejs/plugin-react,
# jsdom, rehype-katex, remark-math, uuid). `npm ci` refuses it, correctly.
# Fixing that means regenerating a standalone lockfile for this package while
# reproducing the root's react/react-dom overrides, which re-resolves the
# whole tree and wants its own verification pass. Until then this step is
# reproducible only to the extent npm's resolver is.
RUN npm install

# Requires .dockerignore to exclude node_modules. Without it this line copies
# the host's macOS tree straight over the one installed above.
COPY . .

ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_API_PREFIX=/api/v1
ARG NEXT_PUBLIC_AXIOM_API_URL=http://localhost:8400
ARG NEXT_PUBLIC_AXIOM_WEB_URL=http://localhost:4100
# Show the demo-login credentials box on the sign-in page. Defaults to "false"
# so a real production build never leaks them; the local compose opts in.
ARG NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_PREFIX=$NEXT_PUBLIC_API_PREFIX \
    NEXT_PUBLIC_AXIOM_API_URL=$NEXT_PUBLIC_AXIOM_API_URL \
    NEXT_PUBLIC_AXIOM_WEB_URL=$NEXT_PUBLIC_AXIOM_WEB_URL \
    NEXT_PUBLIC_SHOW_DEMO_LOGIN=$NEXT_PUBLIC_SHOW_DEMO_LOGIN

RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000

CMD ["npm", "run", "start"]
