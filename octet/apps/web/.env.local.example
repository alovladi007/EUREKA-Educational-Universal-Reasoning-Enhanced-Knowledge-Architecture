# OCTET web app configuration. Copy to .env.local and adjust.

# The OCTET API. Endpoints live under /api/v1.
NEXT_PUBLIC_OCTET_API_URL=http://localhost:8500

# Where a signed-out learner is sent. OCTET owns no identity: EUREKA issues the
# token and hands it to OCTET in the URL hash.
NEXT_PUBLIC_EUREKA_LOGIN_URL=http://localhost:4040/auth/login
