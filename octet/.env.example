# OCTET local configuration. Copy to .env and adjust.
OCTET_ENVIRONMENT=local
OCTET_DATABASE_URL=postgresql+asyncpg://octet:octet@localhost:5442/octet
OCTET_REDIS_URL=redis://localhost:6393/0

# Identity comes from EUREKA. This secret must match EUREKA's JWT_SECRET.
OCTET_IDENTITY_PROVIDER=hmac
OCTET_JWT_SECRET=eureka_dev_secret_key_change_in_production
OCTET_EUREKA_API_URL=http://localhost:8000

# Grading sandbox is on by default and must stay on for any public path.
OCTET_GRADING_SANDBOX=true
OCTET_GRADING_TIMEOUT_SECONDS=5
